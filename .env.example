INSTASCORE_ENVIRONMENT=development
INSTASCORE_VITE_DEV_SERVER=http://localhost:5173
INSTASCORE_DB_VERSION=1
INSTASCORE_FEATURE_FLAGS=

# Milestone 8 push notifications. Browser receives only the App ID; REST API key stays server-side.
INSTASCORE_ONESIGNAL_APP_ID=
INSTASCORE_ONESIGNAL_REST_API_KEY=
INSTASCORE_ONESIGNAL_SAFARI_WEB_ID=
INSTASCORE_NOTIFICATIONS_DISABLED=0
INSTASCORE_NOTIFICATIONS_ALLOW_TEST_FIXTURES=0
INSTASCORE_FOOTBALL_API_KEY=
INSTASCORE_FOOTBALL_API_BASE_URL=https://api-football.instascore.local/v1
INSTASCORE_FOOTBALL_PROVIDER=approved_football_provider
INSTASCORE_BASKETBALL_API_KEY=
INSTASCORE_BASKETBALL_API_BASE_URL=https://api-basketball.instascore.local/v1
